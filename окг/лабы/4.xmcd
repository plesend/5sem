				<p style="Нормаль" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">1. Сместим СК в точку P:</p>
			</text>
		</region>
		<region region-id="14843" left="36" top="1126.5" width="186.75" height="45.75" align-x="54" align-y="1152" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">A1</ml:id>
					<ml:eval placeholderMultiplicationStyle="default">
						<ml:apply>
							<ml:mult/>
							<ml:apply>
								<ml:id xml:space="preserve">Ts</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">Px</ml:id>
									<ml:id xml:space="preserve">Py</ml:id>
								</ml:sequence>
							</ml:apply>
							<ml:id xml:space="preserve">P</ml:id>
						</ml:apply>
						<result xmlns="http://schemas.mathsoft.com/math30">
							<ml:matrix rows="3" cols="5">
								<ml:real>-6</ml:real>
								<ml:real>3</ml:real>
								<ml:real>1</ml:real>
								<ml:real>-4</ml:real>
								<ml:real>2</ml:real>
								<ml:real>1</ml:real>
								<ml:real>-6</ml:real>
								<ml:real>-3</ml:real>
								<ml:real>1</ml:real>
								<ml:real>-4</ml:real>
								<ml:real>-2</ml:real>
								<ml:real>1</ml:real>
								<ml:real>-6</ml:real>
								<ml:real>3</ml:real>
								<ml:real>1</ml:real>
							</ml:matrix>
						</result>
					</ml:eval>
				</ml:define>
			</math>
			<rendering item-idref="43"/>
		</region>
		<region region-id="14844" left="36" top="1185" width="300.75" height="10.5" align-x="39" align-y="1194" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Нормаль" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">2. Повернем смещенный объект на 90 градусов по часовой стрелке:</p>
			</text>
		</region>
		<region region-id="14845" left="36" top="1204.5" width="178.5" height="45.75" align-x="54" align-y="1230" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">A2</ml:id>
					<ml:eval placeholderMultiplicationStyle="default">
						<ml:apply>
							<ml:mult/>
							<ml:apply>
								<ml:id xml:space="preserve">Rs</ml:id>
								<ml:id xml:space="preserve">φ_rad</ml:id>
							</ml:apply>
							<ml:id xml:space="preserve">A1</ml:id>
						</ml:apply>
						<result xmlns="http://schemas.mathsoft.com/math30">
							<ml:matrix rows="3" cols="5">
								<ml:real>2.9999999999999996</ml:real>
								<ml:real>6</ml:real>
								<ml:real>1</ml:real>
								<ml:real>1.9999999999999998</ml:real>
								<ml:real>4</ml:real>
								<ml:real>1</ml:real>
								<ml:real>-3.0000000000000004</ml:real>
								<ml:real>6</ml:real>
								<ml:real>1</ml:real>
								<ml:real>-2.0000000000000004</ml:real>
								<ml:real>4</ml:real>
								<ml:real>1</ml:real>
								<ml:real>2.9999999999999996</ml:real>
								<ml:real>6</ml:real>
								<ml:real>1</ml:real>
							</ml:matrix>
						</result>
					</ml:eval>
				</ml:define>
			</math>
			<rendering item-idref="44"/>
		</region>
		<region region-id="14846" left="36" top="1263" width="209.25" height="10.5" align-x="39" align-y="1272" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
