--3
create sequence S2 
start with 10
increment by 10
maxvalue 100
nocycle;

select S2.NEXTVAL from DUAL;

--4-5
create sequence S3
start with 10
increment by -10
minvalue -100
maxvalue 100
nocycle
order;

