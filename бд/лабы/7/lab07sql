select * from v$tablespace;
create tablespace TS_FIO
  DATAFILE 'TS_FIO_LAB7_PDB.dbf'
  size 7M
  autoextend ON
  next 5M
  maxsize 20M;
  
create temporary tablespace TS_FIO_TEMP
  tempfile 'TS_FIO_TEMP_LAB7_PDB.dbf'
  size 5M
  autoextend ON
  next 3M
  maxsize 30M;
  
drop tablespace TS_FIO including contents and datafiles;
drop tablespace TS_FIO_TEMP including contents and datafiles;
  
CREATE PROFILE ZES LIMIT
  FAILED_LOGIN_ATTEMPTS 7
  SESSIONS_PER_USER 3
  PASSWORD_LIFE_TIME 60
  PASSWORD_REUSE_TIME 365
  PASSWORD_LOCK_TIME 1
  CONNECT_TIME 180;
  
CREATE USER ZES identified by 1234
  DEFAULT TABLESPACE TS_FIO
  TEMPORARY TABLESPACE TS_FIO_TEMP
  PROFILE PF_FIO
  ACCOUNT UNLOCK;
  
  
GRANT CREATE SESSION TO ZES;
GRANT RESTRICTED SESSION TO ZES;
GRANT CREATE ANY TABLE TO ZES;
GRANT CREATE ANY VIEW TO ZES;
GRANT CREATE SEQUENCE TO ZES;
GRANT UNLIMITED TABLESPACE TO ZES;
GRANT CREATE CLUSTER TO ZES;
GRANT CREATE SYNONYM TO ZES;
GRANT CREATE PUBLIC SYNONYM TO ZES;
GRANT CREATE MATERIALIZED VIEW TO ZES;

