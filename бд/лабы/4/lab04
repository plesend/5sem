--1
select tablespace_name from dba_tablespaces;

--2
create tablespace FIO_QDATA
datafile 'fio_qdata.dbf'
size 5m
autoextend on next 5m
maxsize 10m
offline;

alter tablespace FIO_QDATA online;

-- eto prosto nado, y menya net connectiona s usera XXX
create user FIO identified by 1234
default tablespace FIO_QDATA;

grant create session to FIO;
grant create table to FIO;
grant unlimited tablespace to FIO;
-- bolshe ne nado

alter user FIO quota 2m on FIO_QDATA;

create table FIO_T1 (
    id number primary key,
    name nvarchar2(20)
) tablespace FIO_QDATA;

insert into FIO_T1 values(1, 'first');
insert into FIO_T1 values(2, 'second');
insert into FIO_T1 values(3, 'third');

commit;

select * from FIO_T1;

