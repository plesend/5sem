    id int
) storage (buffer_pool keep) tablespace users;

insert into keep_table values (2);
insert into keep_table values (3);

select * from keep_table;
select segment_name, segment_type, tablespace_name, buffer_pool
from user_segments where segment_name like 'KEEP%';

drop table keep_table;

--8
create table def_table (num int) storage (buffer_pool default) tablespace users;
insert into def_table values (2);
insert into def_table values (3);

select * from def_table;
select segment_name, segment_type, tablespace_name, buffer_pool
