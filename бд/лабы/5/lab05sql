--1
select sum(BYTES) from v$sgainfo where name LIKE '%Size%';

--2
select component, current_size/1024/1024 AS size_mb
from v$sga_dynamic_components
where current_size > 0;

--3
select component, granule_size/1024/1024 as granule_mb
from v$sga_dynamic_components
where granule_size is not null;

--4
select name, BYTES
from v$sgainfo where name = 'Free SGA Memory Available';

--5
select name, value from v$parameter where name like 'sga_max%';

--6
select 
    component, 
    min_size,
    max_size, 
    current_size 
from v$sga_dynamic_components
where component in ('KEEP buffer cache', 'DEFAULT buffer cache', 'RECYCLE buffer cache');

